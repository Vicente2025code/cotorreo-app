# Airtable (base principal: Reservas Grupo Cotorreo)
AIRTABLE_PAT=patXXXXXXXXXXXXXX.XXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Airtable (base de Traslados — para /api/tickets/*)
# Si AIRTABLE_PAT tiene acceso a ambas bases, NO hace falta AIRTABLE_PAT_TRASLADOS
AIRTABLE_BASE_TRASLADOS=appA4Exsvfov2JTS6
# AIRTABLE_PAT_TRASLADOS=patYYYYYYYYYYYY.YYYYY  # opcional, override del PAT

# OpenAI (para procesamiento de tickets con GPT-4o mini)
OPENAI_API_KEY=sk-proj-XXXXX

# Clave compartida con el frontend de traslados para autenticar /api/tickets/*
# Si está vacío, el endpoint queda abierto (modo dev) — NO recomendado en producción
TICKETS_API_KEY=cambiar_a_secreto_random_de_32_chars

# JWT secret — genera con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_a_secreto_aleatorio_de_64_chars

# PINs: formato "PIN_NNNN=Nombre|rol[|recordId]"
# Roles soportados: gerencia, lili, maestro, saloneros
# El recordId solo aplica para rol=maestro (apunta al record en tabla Maestros)
#
# Ejemplos:
# PIN_1234=Nombre|gerencia
# PIN_5678=Nombre|lili
# PIN_9012=Nombre|maestro|recXXXXXXXXXXXX
# PIN_3456=Restaurante|saloneros
#
# IMPORTANTE: nunca uses 0001/0002/etc. en producción — son adivinables.

PIN_XXXX=Cambiar|gerencia
PIN_YYYY=Cambiar|lili
PIN_ZZZZ=Cambiar|maestro|recXXXXXXXXXXXX
PIN_WWWW=Restaurante|saloneros

PORT=3000
